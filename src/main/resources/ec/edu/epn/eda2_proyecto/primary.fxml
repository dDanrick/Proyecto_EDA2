<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="portada" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ec.edu.epn.eda2_proyecto.PrimaryController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="encabezado">
         <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
         <ImageView fitHeight="90" preserveRatio="true">
            <image><Image url="@img/escudo_epn.png"/></image>
         </ImageView>
         <VBox spacing="4">
            <Label text="Escuela Politécnica Nacional" styleClass="titulo"/>
            <Label text="Estructura de Datos y Algoritmos II" styleClass="subtitulo"/>
            <Label text="Docente Gustavo Guaigua" styleClass="docente"/>
         </VBox>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="10.0">
         <Label text="Estudiante" styleClass="etiqueta"/>
         <Label fx:id="lblNombre" text="Daniel Hidalgo" styleClass="nombre"/>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER">
         <padding><Insets bottom="30"/></padding>
         <Button fx:id="btnIngresar" text="Ingresar" onAction="#ingresar" styleClass="boton"/>
      </HBox>
   </bottom>
</BorderPane>
